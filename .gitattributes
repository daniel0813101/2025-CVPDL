# ----------------------------------------
# Jupyter Notebook Handling (Best Practice)
# ----------------------------------------

# Use nbstripout to clean notebooks before commit
# *.ipynb filter=nbstripout

# # Avoid merge conflicts: always prefer local version
# *.ipynb merge=ours

# # Disable diff output for notebooks (GitHub/CLI won't show giant JSON)
# *.ipynb diff=none

# # Normalize newline style
*.ipynb text eol=lf

# ----------------------------------------
# Python Files
# ----------------------------------------
*.py text eol=lf

# ----------------------------------------
# Shell / YAML / JSON / Config Files
# ----------------------------------------
*.sh text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf

# ----------------------------------------
# Images, models, binaries (treat as binary)
# ----------------------------------------
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pt binary
*.pth binary
*.ckpt binary
*.onnx binary
*.tflite binary

# ----------------------------------------
# Compressed Files
# ----------------------------------------
*.zip binary
*.tar binary
*.gz  binary
*.7z  binary